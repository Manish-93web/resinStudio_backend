# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (Database > Connect > Drivers). Must be a replica set
# (Atlas clusters always are) - required for multi-document transactions used by checkout.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/resinstudio?retryWrites=true&w=majority
# Only needed if `npm run dev`/seed scripts fail with "querySrv ECONNREFUSED ..." - some local/ISP
# DNS resolvers refuse SRV record queries that mongodb+srv:// requires. Leave empty normally; set
# to a comma-separated DNS server list (e.g. "8.8.8.8,1.1.1.1") only if you hit that specific error.
MONGODB_DNS_SERVERS=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Cloudinary (Dashboard > Account Details)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (Settings > API Keys, use Test Mode keys for now)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe (Dashboard > Developers > API Keys) - international/non-INR checkout, phase 2/3.
# Inert (falls back to a harmless no-op) until STRIPE_SECRET_KEY is set.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Redis (cache-aside layer over hot product/category reads, phase 3). Leave empty to run with no
# cache at all - every read goes straight to MongoDB.
REDIS_URL=

# Algolia (typo-tolerant catalog search, phase 3). Leave empty to keep using MongoDB $text search.
ALGOLIA_APP_ID=
ALGOLIA_API_KEY=
ALGOLIA_SEARCH_API_KEY=
ALGOLIA_INDEX_NAME=products

# Google OAuth (Google Cloud Console > Credentials > OAuth Client ID, type "Web application")
GOOGLE_OAUTH_CLIENT_ID=

# Notification providers - "console" logs to stdout instead of sending, so the full order
# lifecycle is demoable before these accounts exist. Switch to the real provider name once
# you have keys (see IMPLEMENTATION_PROMPT.md §13/§14).
EMAIL_PROVIDER=console
SMS_PROVIDER=console
BREVO_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

FCM_SERVER_KEY=
SENTRY_DSN=

# Comma-separated list of allowed CORS origins
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3000
# This backend's own public origin - used to build absolute URLs for the /static asset mount
# (product photos generated by scripts/generateProductImages.ts when Cloudinary isn't configured).
BACKEND_PUBLIC_URL=http://localhost:4000

COOKIE_SECRET=

# OpenRouter (openrouter.ai/keys) - used only by scripts/generateProductImages.ts, a one-off dev
# tool that generates real product photography via an image-capable model. Not used by the running
# app at all; leave empty unless you're regenerating seed images.
OPENROUTER_API_KEY=
