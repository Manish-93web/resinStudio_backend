# ioredis-mock (dev-only, used to mock Redis in tests) has never published a version whose peer
# dependency allows ioredis@^6 - every 8.x release (8.13.1 is current/latest) still declares
# peer ioredis@^5, conflicting with the real ioredis@^6.0.0 dependency. Since ioredis-mock/
# @types/ioredis-mock never ship in the production runtime, this is safe: it only relaxes npm's
# strict peer-dep resolution (matches --legacy-peer-deps on the CLI) so `npm install` succeeds on
# a clean install (e.g. Render's build) without needing that flag remembered/configured per host.
legacy-peer-deps=true

# npm skips devDependencies entirely when NODE_ENV=production is set during `npm install` - a
# real problem here because typescript/@types/*/jest (all devDependencies) are needed to actually
# build this project (tsc -p tsconfig.json, run via postinstall). Render sets NODE_ENV=production
# for the whole service (build included, not just runtime), so without this override `npm install`
# silently strips out the compiler itself and the build fails with confusing tsc errors instead of
# a clear "not found". Verified empirically: reproduced the exact Render failure locally with
# NODE_ENV=production npm install (typescript/@types/jest/@types/node all ended up missing), then
# confirmed this line fixes it (devDependencies install, `npm run build` succeeds).
include=dev
