# ioredis-mock (dev-only, used to mock Redis in tests) has never published a version whose peer
# dependency allows ioredis@^6 - every 8.x release (8.13.1 is current/latest) still declares
# peer ioredis@^5, conflicting with the real ioredis@^6.0.0 dependency. Since ioredis-mock/
# @types/ioredis-mock never ship in the production runtime, this is safe: it only relaxes npm's
# strict peer-dep resolution (matches --legacy-peer-deps on the CLI) so `npm install` succeeds on
# a clean install (e.g. Render's build) without needing that flag remembered/configured per host.
legacy-peer-deps=true
