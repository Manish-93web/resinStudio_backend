{
  "name": "resinstudio-backend",
  "version": "0.1.0",
  "description": "ResinStudio REST API (Express + MongoDB)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "seed": "tsx scripts/seed.ts",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Manish-93web/resinStudio_backend.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Manish-93web/resinStudio_backend/issues"
  },
  "homepage": "https://github.com/Manish-93web/resinStudio_backend#readme",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@sentry/node": "^10.70.0",
    "algoliasearch": "^5.56.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^11.0.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.2",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "otplib": "^13.4.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "sanitize-html": "^2.17.6",
    "stripe": "^22.5.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
